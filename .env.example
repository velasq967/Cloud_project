# ============================================================
# Configuración local de Docker Compose
# Copiar este archivo a .env y ajustar si es necesario.
# NUNCA subir .env al repositorio.
# ============================================================

# Identidad de la bodega
WAREHOUSE_ID=WH-001

# PostgreSQL local
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=warehouse_pass
POSTGRES_DB=warehouse_db

# Puertos en el host (PC)
DB_PORT=5433
BE_PORT=8001
FE_PORT=8081

# Logs
LOG_LEVEL=INFO

# ============================================================
# Producción / AWS (se usan en docker-compose.prod.yml)
# ============================================================
# DATABASE_URL=postgresql://usuario:password@endpoint-rds:5432/warehouse_db
# API_IMAGE=<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/warehouse-api:1.0.0
# FRONTEND_IMAGE=<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/warehouse-frontend:1.0.0
# S3_BUCKET=warehouse-platform-<algo-unico>
