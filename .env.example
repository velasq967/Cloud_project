# Copiar a .env y ajustar solo si hace falta.
# Nunca subir .env al repositorio.

# Bodega
WAREHOUSE_ID=WH-001
WAREHOUSE_NAME=Bodega principal

# PostgreSQL local
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=warehouse_pass
POSTGRES_DB=warehouse_db
DB_PORT=5433

# API y frontend
BE_PORT=8001
FE_PORT=8081
LOG_LEVEL=INFO
SEED_ON_START=true

# Fase 2 — Redis
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6380

# Fase 3 — RabbitMQ
RABBITMQ_ENABLED=true
RABBITMQ_USER=warehouse
RABBITMQ_PASSWORD=warehouse_pass
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692
RABBITMQ_URL=amqp://warehouse:warehouse_pass@rabbitmq:5672/%2F

# AWS (solo para la fase de despliegue; no poner credenciales aquí)
AWS_REGION=us-east-1
# Debe coincidir con el output s3_bucket de Terraform.
S3_BUCKET=warehouse-platform
